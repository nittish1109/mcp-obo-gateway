# Copy to .env for local runs. NEVER commit .env. In Azure, the secret comes from Key Vault.
TENANT_ID=<directory-tenant-id>
API_CLIENT_ID=<application-client-id-of-the-CONFIDENTIAL-API-app>
API_CLIENT_SECRET=<client-secret-of-the-API-app>
API_APP_ID_URI=api://<application-client-id-of-the-API-app>
REQUIRED_SCOPE=access_as_user
DOWNSTREAM_MCP_URL=https://api.fabric.microsoft.com/v1/mcp/powerbi
DOWNSTREAM_SCOPE=https://analysis.windows.net/powerbi/api/.default
PUBLIC_BASE_URL=https://<your-container-app-fqdn>
# RESOURCE_IDENTIFIER=   (optional; defaults to <PUBLIC_BASE_URL>/mcp)
